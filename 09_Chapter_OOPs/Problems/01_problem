"""Create a class “Programmer” for storing information of few programmers
working at Microsoft."""

class programmer:
    company = "Microsoft"

    def __init__(self, name, salary, pin):
        self.name = name
        self.salary = salary
        self.pin = pin


employee1 = programmer("Aasif", 1200000, 121)
print(f"{employee1.name} works in {employee1.company} has salary {employee1.salary} under pin number {employee1.pin}")


employee2 = programmer("Ayan", 1000000, 123)
print(f"{employee2.name} works in {employee2.company} has salary {employee2.salary} under pin number {employee2.pin}")
